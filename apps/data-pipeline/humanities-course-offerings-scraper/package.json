{
  "name": "@apps/humanities-course-offerings-scraper",
  "version": "0.0.0",
  "private": true,
  "description": "Shared PDF importer for UCI School of Humanities planned course schedules",
  "type": "module",
  "scripts": {
    "check:types": "tsc -p ./tsconfig.json -noEmit",
    "deploy": "wrangler deploy",
    "postinstall": "wrangler types",
    "start": "dotenv -e ../../../.env -- tsx src/index.ts",
    "test": "tsx --test src/lib.test.ts"
  },
  "dependencies": {
    "@packages/db": "workspace:*",
    "pdfjs-dist": "4.10.38",
    "pureimage": "0.4.20",
    "tesseract-wasm": "0.11.0"
  },
  "devDependencies": {
    "wrangler": "catalog:"
  }
}
